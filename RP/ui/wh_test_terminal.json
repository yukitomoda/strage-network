{
  "namespace": "wh_test",

  "poc_label": {
    "type": "label",
    "layer": 2,
    "offset": [ 7, -1 ],
    "size": [ "90%", "default" ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "text": "§bPoC: 独自グリッド(chest_screen上書き)",
    "color": "$title_text_color",
    "localize": false,
    "enable_profanity_filter": false
  },

  "order_slot_button_ref@common.container_slot_button_prototype": {
    "button_mappings": [
      { "from_button_id": "button.menu_select", "to_button_id": "button.drop_one", "mapping_type": "pressed" },
      { "from_button_id": "button.menu_ok", "to_button_id": "button.drop_one", "mapping_type": "pressed" },
      { "from_button_id": "button.menu_secondary_select", "to_button_id": "button.drop_all", "mapping_type": "pressed" },
      { "from_button_id": "button.menu_auto_place", "to_button_id": "button.drop_all", "mapping_type": "pressed" }
    ]
  },

  "display_slot_button_ref@common.container_slot_button_prototype": {
    "button_mappings": [ ]
  },

  "invisible_background": {
    "type": "panel"
  },

  "display_item@common.container_item": {
    "$item_collection_name": "container_items",
    "$button_ref": "wh_test.display_slot_button_ref",
    "$stack_count_required": false,
    "$background_images": "wh_test.invisible_background"
  },

  "terminal_grid": {
    "type": "collection_panel",
    "size": [ 162, 18 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "collection_name": "container_items",
    "$item_collection_name": "container_items",
    "controls": [
      { "display_0@wh_test.display_item": { "collection_index": 0, "offset": [ -72, 0 ] } },
      { "display_1@wh_test.display_item": { "collection_index": 1, "offset": [ -54, 0 ] } },
      { "display_2@wh_test.display_item": { "collection_index": 2, "offset": [ -36, 0 ] } },
      { "display_3@wh_test.display_item": { "collection_index": 3, "offset": [ -18, 0 ] } },
      { "display_4@wh_test.display_item": { "collection_index": 4, "offset": [ 0, 0 ] } },
      {
        "slot_0@common.container_item": {
          "collection_index": 5,
          "offset": [ -72, 0 ],
          "layer": 6,
          "$item_collection_name": "container_items",
          "$button_ref": "wh_test.order_slot_button_ref",
          "$stack_count_required": false,
          "$background_images": "wh_test.invisible_background"
        }
      },
      {
        "slot_1@common.container_item": {
          "collection_index": 6,
          "offset": [ -54, 0 ],
          "layer": 6,
          "$item_collection_name": "container_items",
          "$button_ref": "wh_test.order_slot_button_ref",
          "$stack_count_required": false,
          "$background_images": "wh_test.invisible_background"
        }
      },
      {
        "slot_2@common.container_item": {
          "collection_index": 7,
          "offset": [ -36, 0 ],
          "layer": 6,
          "$item_collection_name": "container_items",
          "$button_ref": "wh_test.order_slot_button_ref",
          "$stack_count_required": false,
          "$background_images": "wh_test.invisible_background"
        }
      },
      {
        "slot_3@common.container_item": {
          "collection_index": 8,
          "offset": [ -18, 0 ],
          "layer": 6,
          "$item_collection_name": "container_items",
          "$button_ref": "wh_test.order_slot_button_ref",
          "$stack_count_required": false,
          "$background_images": "wh_test.invisible_background"
        }
      },
      {
        "slot_4@common.container_item": {
          "collection_index": 9,
          "offset": [ 0, 0 ],
          "layer": 6,
          "$item_collection_name": "container_items",
          "$button_ref": "wh_test.order_slot_button_ref",
          "$stack_count_required": false,
          "$background_images": "wh_test.invisible_background"
        }
      },
      { "display_5@wh_test.display_item": { "collection_index": 15, "offset": [ 18, 0 ] } },
      {
        "slot_5@common.container_item": {
          "collection_index": 16,
          "offset": [ 18, 0 ],
          "layer": 6,
          "$item_collection_name": "container_items",
          "$button_ref": "wh_test.order_slot_button_ref",
          "$stack_count_required": false,
          "$background_images": "wh_test.invisible_background"
        }
      },
      { "display_6@wh_test.display_item": { "collection_index": 17, "offset": [ 36, 0 ] } },
      {
        "slot_6@common.container_item": {
          "collection_index": 18,
          "offset": [ 36, 0 ],
          "layer": 6,
          "$item_collection_name": "container_items",
          "$button_ref": "wh_test.order_slot_button_ref",
          "$stack_count_required": false,
          "$background_images": "wh_test.invisible_background"
        }
      }
    ]
  },

  "count_label": {
    "type": "label",
    "size": [ 18, 18 ],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "offset": [ 0, 1 ],
    "layer": 9,
    "shadow": true,
    "text_alignment": "right",
    "font_scale_factor": 0.55,
    "text": "#hover_text",
    "color": [ 1, 1, 1 ],
    "bindings": [
      {
        "binding_name": "#hover_text",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      }
    ]
  },

  "count_label_grid": {
    "type": "collection_panel",
    "size": [ 162, 18 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "collection_name": "container_items",
    "$item_collection_name": "container_items",
    "controls": [
      { "count_label_0@wh_test.count_label": { "collection_index": 10, "offset": [ -144, 8 ] } },
      { "count_label_1@wh_test.count_label": { "collection_index": 11, "offset": [ -126, 8 ] } },
      { "count_label_2@wh_test.count_label": { "collection_index": 12, "offset": [ -108, 8 ] } },
      { "count_label_3@wh_test.count_label": { "collection_index": 13, "offset": [ -90, 8 ] } },
      { "count_label_4@wh_test.count_label": { "collection_index": 14, "offset": [ -72, 8 ] } }
    ]
  },

  "search_box@common.text_edit_box": {
    "size": [ 80, 14 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "layer": 3,
    "max_length": 24,
    "$text_box_name": "wh_test_search_box",
    "$text_edit_text_control": "wh_test_search_box_text_control",
    "$place_holder_text": "検索..."
  },

  "search_dim_overlay": {
    "type": "image",
    "texture": "textures/items/search_dim_overlay",
    "size": [ 18, 18 ],
    "layer": 20,
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "wh_test_search_box_text_control",
        "source_property_name": "#item_name",
        "target_property_name": "#edit_box_input"
      },
      {
        "binding_name": "#hover_text",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#hover_text - #edit_box_input) = #hover_text and not (#edit_box_input = ''))",
        "target_property_name": "#visible"
      }
    ]
  },

  "search_overlay_grid": {
    "type": "collection_panel",
    "size": [ 162, 18 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "collection_name": "container_items",
    "$item_collection_name": "container_items",
    "controls": [
      { "search_overlay_0@wh_test.search_dim_overlay": { "collection_index": 0, "offset": [ -72, 0 ] } },
      { "search_overlay_1@wh_test.search_dim_overlay": { "collection_index": 1, "offset": [ -54, 0 ] } },
      { "search_overlay_2@wh_test.search_dim_overlay": { "collection_index": 2, "offset": [ -36, 0 ] } },
      { "search_overlay_3@wh_test.search_dim_overlay": { "collection_index": 3, "offset": [ -18, 0 ] } },
      { "search_overlay_4@wh_test.search_dim_overlay": { "collection_index": 4, "offset": [ 0, 0 ] } }
    ]
  },

  "terminal_panel_top_half": {
    "type": "panel",
    "size": [ "100%", "50%" ],
    "offset": [ 0, 12 ],
    "anchor_to": "top_left",
    "anchor_from": "top_left",
    "controls": [
      { "poc_label@wh_test.poc_label": { } },
      {
        "search_box@wh_test.search_box": {
          "offset": [ 88, -2 ]
        }
      },
      {
        "terminal_grid@wh_test.terminal_grid": {
          "offset": [ 7, 9 ]
        }
      },
      {
        "count_label_grid@wh_test.count_label_grid": {
          "offset": [ 7, 9 ]
        }
      },
      {
        "search_overlay_grid@wh_test.search_overlay_grid": {
          "offset": [ 7, 9 ]
        }
      }
    ]
  },

  "terminal_panel": {
    "type": "panel",
    "controls": [
      { "container_gamepad_helpers@common.container_gamepad_helpers": { } },
      { "selected_item_details_factory@common.selected_item_details_factory": { } },
      { "item_lock_notification_factory@common.item_lock_notification_factory": { } },
      {
        "root_panel@common.root_panel": {
          "layer": 1,
          "controls": [
            { "common_panel@common.common_panel": { } },
            {
              "chest_panel": {
                "type": "panel",
                "layer": 5,
                "controls": [
                  { "terminal_panel_top_half@wh_test.terminal_panel_top_half": { } },
                  { "inventory_panel_bottom_half_with_label@common.inventory_panel_bottom_half_with_label": { } },
                  { "hotbar_grid@common.hotbar_grid_template": { } },
                  { "inventory_take_progress_icon_button@common.inventory_take_progress_icon_button": { } },
                  { "flying_item_renderer@common.flying_item_renderer": { "layer": 15 } }
                ]
              }
            },
            { "inventory_selected_icon_button@common.inventory_selected_icon_button": { } },
            { "gamepad_cursor@common.gamepad_cursor_button": { } }
          ]
        }
      }
    ]
  }
}
