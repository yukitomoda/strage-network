{
  "format_version": "1.21.40",
  "render_controllers": {
    "controller.render.member_highlight": {
      "arrays": {
        "textures": {
          "array.wh_member_highlight_colors": ["Texture.default", "Texture.drain"]
        }
      },
      "geometry": "Geometry.default",
      "materials": [{ "*": "Material.default" }],
      "textures": ["array.wh_member_highlight_colors[q.property('wh:drain')]"],
      "part_visibility": [
        { "*": false },
        { "vert_en": "q.property('wh:visible_vert_en')" },
        { "vert_wn": "q.property('wh:visible_vert_wn')" },
        { "vert_es": "q.property('wh:visible_vert_es')" },
        { "vert_ws": "q.property('wh:visible_vert_ws')" },
        { "top_n": "q.property('wh:visible_top_n')" },
        { "top_s": "q.property('wh:visible_top_s')" },
        { "top_w": "q.property('wh:visible_top_w')" },
        { "top_e": "q.property('wh:visible_top_e')" },
        { "bottom_n": "q.property('wh:visible_bottom_n')" },
        { "bottom_s": "q.property('wh:visible_bottom_s')" },
        { "bottom_w": "q.property('wh:visible_bottom_w')" },
        { "bottom_e": "q.property('wh:visible_bottom_e')" }
      ]
    }
  }
}
