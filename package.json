{
  "name": "mc-addon",
  "private": true,
  "type": "module",
  "scripts": {
    "build:icon": "node tools/generate-placeholder-icon.mjs",
    "build:scripts": "esbuild scripts-src/main.ts --bundle --format=esm --target=es2020 --outfile=BP/scripts/main.js --external:@minecraft/server --external:@minecraft/server-ui",
    "build": "npm run build:icon && npm run build:scripts",
    "watch": "esbuild scripts-src/main.ts --bundle --format=esm --target=es2020 --outfile=BP/scripts/main.js --external:@minecraft/server --external:@minecraft/server-ui --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@minecraft/server": "^2.1.0",
    "@minecraft/server-ui": "^2.1.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
